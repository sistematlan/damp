# Environment (contains local config)
.env

# Caddy generated certs
core/caddy/*.crt
core/caddy/*.key
core/caddy/*.pem

# Project overrides (personal, not shared)
core/caddy/projects.d/*.caddy
core/caddy/projects.d/registry.json
!core/caddy/projects.d/.gitkeep

# OS files
.DS_Store
Thumbs.db

# Claude Code
.claude/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Desktop app build artifacts
app/node_modules/
app/dist/
app/src-tauri/target/

# Dashboard build artifacts
core/dashboard/tmp/
core/dashboard/dashboard

# SQL dumps and backups
*.sql.gz
backups/
data/
