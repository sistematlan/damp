# =============================================================
# DAMP — Configuration
# =============================================================
# Copy this file to .env and adjust as needed:
#   cp .env.example .env
# =============================================================

# ── General ─────────────────────────────────────────────────
TZ=America/Mexico_City

# ── Caddy (Reverse Proxy) ──────────────────────────────────
CADDY_EMAIL=admin@localhost

# ── Domains — used by Caddyfile ─────────────────────────────
PMA_DOMAIN=pma.local
MAIL_DOMAIN=mail.local

# ── MySQL ───────────────────────────────────────────────────
DB_ROOT_PASSWORD=root
DB_PORT=3306

# ── PHPMyAdmin ──────────────────────────────────────────────
PMA_PORT=8080

# ── Mailpit ─────────────────────────────────────────────────
MAIL_HTTP_PORT=8025
MAIL_SMTP_PORT=1025

# ── Projects ────────────────────────────────────────────────
# Add your project domains here. Each needs a block in Caddyfile.
# MY_PROJECT_DOMAIN=myproject.local
