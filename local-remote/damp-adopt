#!/usr/bin/env bash
# =============================================================
#  damp-adopt — bring a local project onto the remote DAMP host
# -------------------------------------------------------------
#  Run this ON YOUR MAC, from anywhere. It automates the
#  "adopt a project on the MSI" recipe so it works for any user
#  and any project, with no hardcoded paths or credentials.
#
#  It will:
#    1. Generate/extend the project's mutagen.yml and start sync
#    2. Build + start the project's containers on the MSI
#    3. Register the project domain in the global Caddy + reload
#    4. composer install inside the MSI (PHP projects)
#    5. Create CI4 writable/ dirs (if applicable)
#    6. Create DB + user on the MSI; optionally copy the local DB
#    7. Verify https://<project>.<TLD>
#
#  Config comes from ~/.config/damp-remote/config (written by
#  setup-mac.sh): DAMP_REMOTE_HOST, DAMP_REMOTE_DIR, DAMP_REMOTE_PORT.
#
#  Usage:
#    damp-adopt [path-to-project]      # defaults to current dir
#    damp-adopt ~/sourcecode/myapp
#    damp-adopt --no-db ~/sourcecode/myapp   # skip DB copy
# =============================================================
set -euo pipefail

GREEN="\033[0;32m"; YELLOW="\033[0;33m"; RED="\033[0;31m"
BOLD="\033[1m"; DIM="\033[2m"; NC="\033[0m"

die()  { echo -e "${RED}error:${NC} $*" >&2; exit 1; }
info() { echo -e "${DIM}$*${NC}"; }
ok()   { echo -e "${GREEN}✔${NC} $*"; }
warn() { echo -e "${YELLOW}!${NC} $*"; }
step() { echo -e "\n${BOLD}$*${NC}"; }

confirm() {
  local prompt="$1" ans=""
  printf "%s [y/N]: " "$prompt" >&2
  read -r ans </dev/tty || ans="N"
  [ "$ans" = "y" ] || [ "$ans" = "Y" ]
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ── Load damp-remote config ────────────────────────────────────
CFG="${DAMP_REMOTE_CONFIG:-$HOME/.config/damp-remote/config}"
[ -f "$CFG" ] || die "missing $CFG — run: bash local-remote/setup-mac.sh"
# shellcheck disable=SC1090
set -a; source "$CFG"; set +a
REMOTE_HOST="${DAMP_REMOTE_HOST:-}"; REMOTE_DIR="${DAMP_REMOTE_DIR:-}"; REMOTE_PORT="${DAMP_REMOTE_PORT:-22}"
[ -n "$REMOTE_HOST" ] && [ -n "$REMOTE_DIR" ] || die "DAMP_REMOTE_HOST / DAMP_REMOTE_DIR not set in $CFG"
DAMP_BIN="${DAMP_REMOTE_BIN:-$REMOTE_DIR/core/bin/damp}"
SSH() { ssh -p "$REMOTE_PORT" -o ConnectTimeout=12 "$REMOTE_HOST" "$@"; }
SSH_TTY() { ssh -tt -p "$REMOTE_PORT" -o ConnectTimeout=12 "$REMOTE_HOST" "$@"; }

# ── Args ───────────────────────────────────────────────────────
DO_DB=1
PROJ_PATH=""
while [ $# -gt 0 ]; do
  case "$1" in
    --no-db) DO_DB=0; shift ;;
    -h|--help) grep '^#' "$0" | sed 's/^# \{0,1\}//' | sed -n '2,30p'; exit 0 ;;
    *) PROJ_PATH="$1"; shift ;;
  esac
done
[ -n "$PROJ_PATH" ] || PROJ_PATH="$(pwd)"
PROJ_PATH="$(cd "$PROJ_PATH" 2>/dev/null && pwd)" || die "no such directory: $PROJ_PATH"
PROJECT="$(basename "$PROJ_PATH" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9-]/-/g; s/-\{2,\}/-/g; s/^-//; s/-$//')"
TLD="$(SSH "grep -E '^DAMP_TLD=' $REMOTE_DIR/core/.env 2>/dev/null | cut -d= -f2" | tr -d '\r' || true)"
[ -n "$TLD" ] || TLD="test"
DOMAIN="${PROJECT}.${TLD}"
REMOTE_PROJ="\$HOME/sourcecode/${PROJECT}"

echo -e "${BOLD}damp-adopt${NC} — ${PROJECT} → ${REMOTE_HOST} (https://${DOMAIN})"
info "local : $PROJ_PATH"
info "remote: ~/sourcecode/${PROJECT} on ${REMOTE_HOST}"

# Detect project type from local files.
TYPE="unknown"
[ -f "$PROJ_PATH/spark" ] && TYPE="ci4"
[ -f "$PROJ_PATH/artisan" ] && TYPE="laravel"
[ -f "$PROJ_PATH/composer.json" ] && [ "$TYPE" = "unknown" ] && TYPE="php"
[ -f "$PROJ_PATH/package.json" ] && [ "$TYPE" = "unknown" ] && TYPE="node"
info "detected type: ${TYPE}"

# ── 1. Mutagen sync ────────────────────────────────────────────
step "[1/7] Code sync (mutagen)"
command -v mutagen >/dev/null 2>&1 || die "mutagen not installed (run setup-mac.sh)"
if [ ! -f "$PROJ_PATH/mutagen.yml" ]; then
  cat > "$PROJ_PATH/mutagen.yml" <<EOF
# Generated by damp-adopt. Edit if you need custom ignores.
sync:
  defaults:
    mode: "two-way-resolved"
    ignore:
      vcs: true
      paths:
        - "node_modules/"
        - "vendor/"
        - "dist/"
        - "build/"
        - ".next/"
        - ".nuxt/"
        - ".turbo/"
        - ".cache/"
        - "writable/"
        - "storage/framework/"
        - "bootstrap/cache/"
        - "var/cache/"
        - "var/log/"
        - ".DS_Store"
        - ".idea/"
        - "*.swp"
    symlink:
      mode: "posix-raw"
    watch:
      mode: "portable"
      pollingInterval: 2
    permissions:
      defaultFileMode: 0644
      defaultDirectoryMode: 0755
  ${PROJECT}:
    alpha: "${PROJ_PATH}"
    beta:  "${REMOTE_HOST}:~/sourcecode/${PROJECT}"
EOF
  ok "Wrote ${PROJ_PATH}/mutagen.yml"
  grep -q "^mutagen.yml$" "$PROJ_PATH/.gitignore" 2>/dev/null || echo "mutagen.yml" >> "$PROJ_PATH/.gitignore"
else
  info "mutagen.yml already exists; leaving as-is"
fi

( cd "$PROJ_PATH" && mutagen project start 2>/dev/null || mutagen project resume 2>/dev/null || true )
info "Waiting for initial sync to settle..."
for _ in $(seq 1 30); do
  if ( cd "$PROJ_PATH" && mutagen sync list 2>/dev/null | grep -q "Watching for changes" ); then break; fi
  sleep 2
done
SSH "test -f ~/sourcecode/${PROJECT}/composer.json -o -f ~/sourcecode/${PROJECT}/package.json" \
  && ok "Code present on ${REMOTE_HOST}" || warn "Sync may still be running; continuing"

# ── 2. Build + start on the MSI ────────────────────────────────
step "[2/7] Build + start containers on the MSI"
if SSH "docker ps --format '{{.Names}}' | grep -qx ${PROJECT}"; then
  ok "Container '${PROJECT}' already running"
else
  if ! SSH "test -f ~/sourcecode/${PROJECT}/Dampfile"; then
    warn "No Dampfile on the remote. Initialize once (interactive):"
    echo -e "  ${BOLD}ssh -t ${REMOTE_HOST} 'cd ~/sourcecode/${PROJECT} && ${DAMP_BIN} init'${NC}"
    confirm "Run 'damp init' now (interactive)?" && SSH_TTY "cd ~/sourcecode/${PROJECT} && ${DAMP_BIN} init" || true
  fi
  info "Starting (first build can take minutes; running in background on the MSI)..."
  SSH "cd ${REMOTE_DIR} && nohup ${DAMP_BIN} start ${PROJECT} > /tmp/${PROJECT}-start.log 2>&1 & echo started"
  for _ in $(seq 1 90); do
    SSH "docker ps --format '{{.Names}}' | grep -qx ${PROJECT}" && break
    sleep 5
  done
  SSH "docker ps --format '{{.Names}}' | grep -qx ${PROJECT}" \
    && ok "Container '${PROJECT}' is up" \
    || { warn "Build still going. Tail it with:"; echo -e "  ssh ${REMOTE_HOST} 'tail -f /tmp/${PROJECT}-start.log'"; }
fi

# ── 3. Register domain in the global Caddy ─────────────────────
step "[3/7] Register ${DOMAIN} in the global Caddy"
if SSH "test -f ${REMOTE_DIR}/core/caddy/projects.d/${PROJECT}.caddy"; then
  ok "Caddy route already exists"
else
  # upstream = real container_name (frankenphp listens on :80; php-fpm uses the -web nginx)
  UPSTREAM="$(SSH "grep -E 'container_name:.*-web' ~/sourcecode/${PROJECT}/docker-compose.yml 2>/dev/null | head -1 | awk '{print \$2}'" | tr -d '\r')"
  [ -n "$UPSTREAM" ] || UPSTREAM="$(SSH "grep -m1 'container_name:' ~/sourcecode/${PROJECT}/docker-compose.yml 2>/dev/null | awk '{print \$2}'" | tr -d '\r')"
  [ -n "$UPSTREAM" ] || UPSTREAM="$PROJECT"
  SSH "printf '%s.%s {\n    reverse_proxy %s:80\n}\n' '${PROJECT}' '${TLD}' '${UPSTREAM}' > ${REMOTE_DIR}/core/caddy/projects.d/${PROJECT}.caddy"
  ok "Wrote projects.d/${PROJECT}.caddy (upstream ${UPSTREAM}:80)"
fi
SSH "cd ${REMOTE_DIR} && ${DAMP_BIN} reload" >/dev/null 2>&1 && ok "Caddy reloaded" || warn "Caddy reload failed"

# ── 4. Composer (PHP projects) ─────────────────────────────────
if [ "$TYPE" = "ci4" ] || [ "$TYPE" = "laravel" ] || [ "$TYPE" = "php" ]; then
  step "[4/7] composer install (inside the MSI)"
  if SSH "test -f ~/sourcecode/${PROJECT}/vendor/autoload.php"; then
    ok "vendor/ already present"
  else
    info "Running composer via official image (ignoring platform reqs; runtime container has the extensions)..."
    SSH "docker run --rm -v ~/sourcecode/${PROJECT}:/app -w /app composer:2 install --no-interaction --no-progress --ignore-platform-reqs" \
      && ok "composer install done" || warn "composer install had issues"
  fi
fi

# ── 5. CI4 writable/ ───────────────────────────────────────────
if [ "$TYPE" = "ci4" ]; then
  step "[5/7] CI4 writable/ runtime dirs"
  SSH "docker exec ${PROJECT} sh -c 'mkdir -p /app/writable/cache /app/writable/logs /app/writable/session /app/writable/uploads /app/writable/debugbar && chmod -R 777 /app/writable'" \
    && ok "writable/ ready" || warn "could not create writable/ (container up?)"
else
  info "[5/7] writable/ — not a CI4 project, skipped"
fi

# ── 6. Database ────────────────────────────────────────────────
if [ "$DO_DB" = "1" ] && { [ "$TYPE" = "ci4" ] || [ "$TYPE" = "laravel" ] || [ "$TYPE" = "php" ]; }; then
  step "[6/7] Database"
  # Read DB settings from the project's .env (supports CI4 and Laravel keys).
  ENV_REMOTE="$(SSH "cat ~/sourcecode/${PROJECT}/.env 2>/dev/null" || true)"
  getenv() { echo "$ENV_REMOTE" | grep -iE "$1" | grep -v '^\s*#' | head -1 | sed -E 's/.*=\s*//; s/\r//; s/^["'\'']//; s/["'\'']$//'; }
  DBNAME="$(getenv 'database\.default\.database|^DB_DATABASE')"
  DBUSER="$(getenv 'database\.default\.username|^DB_USERNAME')"
  DBPASS="$(getenv 'database\.default\.password|^DB_PASSWORD')"
  if [ -z "$DBNAME" ] || [ -z "$DBUSER" ]; then
    warn "Could not read DB name/user from the project's .env; skipping DB step."
    info "Configure it manually, then re-run with the right .env."
  else
    info "DB '${DBNAME}', user '${DBUSER}' (from .env)"
    SSH "docker exec damp-db mysql -uroot -proot -e 'CREATE DATABASE IF NOT EXISTS \`${DBNAME}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci; CREATE USER IF NOT EXISTS \"${DBUSER}\"@\"%\" IDENTIFIED BY \"${DBPASS}\"; ALTER USER \"${DBUSER}\"@\"%\" IDENTIFIED BY \"${DBPASS}\"; GRANT ALL PRIVILEGES ON \`${DBNAME}\`.* TO \"${DBUSER}\"@\"%\"; FLUSH PRIVILEGES;' 2>/dev/null" \
      && ok "DB + user ensured on the MSI" || warn "Could not create DB/user"

    # Offer to copy data from a local MySQL (OrbStack) if it has this DB.
    if command -v docker >/dev/null 2>&1 && docker exec damp-db true >/dev/null 2>&1; then
      if docker exec damp-db mysql -uroot -proot -N -e "SELECT SCHEMA_NAME FROM information_schema.schemata WHERE SCHEMA_NAME='${DBNAME}';" 2>/dev/null | grep -qx "$DBNAME"; then
        if confirm "Local DB '${DBNAME}' found (OrbStack). Copy it to the MSI now? (overwrites remote tables)"; then
          dump="$(mktemp)"
          docker exec damp-db mysqldump -uroot -proot --single-transaction --no-tablespaces --routines --triggers --events "$DBNAME" > "$dump" 2>/dev/null
          SSH "docker exec -i damp-db mysql -uroot -proot ${DBNAME}" < "$dump" && ok "Copied local DB → MSI ($(grep -c 'CREATE TABLE' "$dump") tables)" || warn "DB copy failed"
          rm -f "$dump"
        fi
      else
        info "No local DB named '${DBNAME}' in OrbStack; bring data via migrations or a dump yourself."
      fi
    fi
  fi
else
  info "[6/7] Database — skipped (--no-db or non-PHP project)"
fi

# ── 7. Verify ──────────────────────────────────────────────────
step "[7/7] Verify"
sleep 2
code="$(curl -sL -m 25 -o /dev/null -w '%{http_code}' "https://${DOMAIN}/" 2>/dev/null || echo 000)"
if [ "$code" = "200" ] || [ "$code" = "302" ] || [ "$code" = "301" ]; then
  ok "https://${DOMAIN}/ responded HTTP ${code}"
  echo -e "\n${GREEN}${BOLD}Done.${NC} Open it: ${BOLD}open https://${DOMAIN}${NC}"
else
  warn "https://${DOMAIN}/ returned HTTP ${code}. Check:"
  echo -e "  ssh ${REMOTE_HOST} 'docker logs --tail 30 ${PROJECT}'"
  echo -e "  See the 'error map' in local-remote/REMOTE.md (Fase 4)."
fi
