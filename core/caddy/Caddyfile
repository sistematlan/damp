# =============================================================
# DAMP — Global Reverse Proxy
# =============================================================
# Each *.test domain gets automatic HTTPS.
# To add a project:
#   1. Add DOMAIN=name.test in .env
#   2. Add a block here pointing to the container:port
#   3. Run: damp reload
# =============================================================
{
    local_certs
    admin 0.0.0.0:2019
}

# Snippet imported by every project block.
# Adds zstd/gzip compression — DataTables 4.7 MB → ~1.2 MB, etc.
(common) {
    encode zstd gzip
}

# ── Dashboard ──────────────────────────────────────────────
{$DAMP_DOMAIN:damp.test} {
    import common
    reverse_proxy damp-dashboard:9000
}

# ── PHPMyAdmin ──────────────────────────────────────────────
{$PMA_DOMAIN} {
    import common
    reverse_proxy damp-phpmyadmin:80
}

# ── Mailpit ─────────────────────────────────────────────────
{$MAIL_DOMAIN} {
    import common
    reverse_proxy damp-mailpit:8025
}

# ╔═══════════════════════════════════════════════════════════╗
# ║  PROJECTS                                                ║
# ╚═══════════════════════════════════════════════════════════╝
# Add your project blocks below. Example:
#
# {$MY_PROJECT_DOMAIN} {
#     reverse_proxy my-project-app:80
# }

# Import local overrides (optional, gitignored)
import /etc/caddy/projects.d/*.caddy
