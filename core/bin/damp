#!/bin/bash
# =============================================================
#  DAMP — Dockerized Auto-SSL Modern Platform
#  A modern replacement for MAMP, XAMPP, WAMP, and LAMP.
# =============================================================
set -euo pipefail

# Find real script location even if called via symlink
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
BIN_DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
DAMP_CORE_DIR="$(cd "$BIN_DIR/.." && pwd)"
DAMP_ROOT_DIR="$(cd "$DAMP_CORE_DIR/.." && pwd)"
DAMP_VERSION="$(cat "$DAMP_ROOT_DIR/VERSION" 2>/dev/null || echo "unknown")"

GREEN="\033[0;32m"
YELLOW="\033[0;33m"
RED="\033[0;31m"
BOLD="\033[1m"
DIM="\033[2m"
NC="\033[0m"

PROJECTS_DIR="$DAMP_CORE_DIR/caddy/projects.d"
TEMPLATES_DIR="$DAMP_CORE_DIR/templates"

# Load .env for DAMP_TLD and other settings
if [ -f "$DAMP_CORE_DIR/.env" ]; then
  set -a
  source "$DAMP_CORE_DIR/.env"
  set +a
fi
DAMP_TLD="${DAMP_TLD:-test}"

# ── Detect project type from existing files ────────────────────
detect_template() {
  local dir="$1"
  if [ -f "$dir/wp-config.php" ] || [ -d "$dir/wp-content" ]; then
    echo "wordpress"
  elif [ -f "$dir/composer.json" ]; then
    if grep -q '"laravel/framework"' "$dir/composer.json" 2>/dev/null; then
      echo "frankenphp"
    elif grep -q '"codeigniter4/framework"' "$dir/composer.json" 2>/dev/null; then
      echo "frankenphp"
    elif grep -q '"symfony/' "$dir/composer.json" 2>/dev/null; then
      echo "frankenphp"
    else
      # Check PHP version requirement to decide legacy vs modern
      local php_req
      php_req=$(grep -o '"php":\s*"[^"]*"' "$dir/composer.json" 2>/dev/null || true)
      if echo "$php_req" | grep -qE '5\.[0-9]'; then
        echo "php-ancient"
      elif echo "$php_req" | grep -qE '7\.[0-4]'; then
        echo "php-legacy"
      else
        echo "php-fpm"
      fi
    fi
  elif [ -f "$dir/package.json" ]; then
    echo "node"
  elif ls "$dir"/*.php &>/dev/null; then
    echo "php-fpm"
  else
    echo ""
  fi
}

# ── Interactive template selector ──────────────────────────────
select_template() {
  local templates=()
  local descriptions=()
  while IFS= read -r t; do
    templates+=("$t")
  done < <(ls -1 "$TEMPLATES_DIR")

  descriptions=("PHP 8.4 + FrankenPHP (Laravel, CI4, Symfony)" "Node.js 22 (React, Vue, Astro, Express)" "PHP 5.6 + Apache (legacy rescue)" "PHP 8.4 + Nginx + FPM (classic)" "PHP 7.4 + Nginx + FPM (CI3, Laravel 8)" "WordPress (official image)")

  echo -e "${BOLD}Available templates:${NC}" >&2
  echo "" >&2
  for i in "${!templates[@]}"; do
    echo -e "  ${BOLD}$((i+1)))${NC} ${templates[$i]}  ${DIM}— ${descriptions[$i]}${NC}" >&2
  done
  echo "" >&2
  echo -n "Select template [1-${#templates[@]}]: " >&2
  if (echo >/dev/tty) 2>/dev/null; then
    read -r choice </dev/tty || choice=""
  else
    read -r choice || choice=""
  fi

  if [ -n "$choice" ] && [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#templates[@]}" ]; then
    echo "${templates[$((choice-1))]}"
  else
    echo ""
  fi
}

# ── Read input with fallback (works in pipes and TTY) ──────────
read_input() {
  local prompt="$1"
  local default="${2:-}"
  echo -n "$prompt" >&2
  if (echo >/dev/tty) 2>/dev/null; then
    read -r value </dev/tty || value=""
  else
    read -r value || value=""
  fi
  if [ -z "$value" ] && [ -n "$default" ]; then
    value="$default"
  fi
  echo "$value"
}

# ── Detect PHP version from composer.json ──────────────────────
detect_php_version() {
  local dir="$1"
  local composer="$dir/composer.json"
  if [ -f "$composer" ]; then
    local php_req
    php_req=$(grep -o '"php":\s*"[^"]*"' "$composer" 2>/dev/null || true)
    if echo "$php_req" | grep -qE '5\.[0-9]'; then
      echo "5.6"
    elif echo "$php_req" | grep -qE '7\.[0-4]'; then
      echo "7.4"
    elif echo "$php_req" | grep -qE '8\.[0-1]'; then
      echo "8.1"
    elif echo "$php_req" | grep -qE '8\.[2-3]'; then
      echo "8.3"
    else
      echo "8.4"
    fi
  else
    echo "8.4"
  fi
}

# ── Detect document root ───────────────────────────────────────
detect_document_root() {
  local dir="$1"
  local type="$2"
  if [ "$type" = "frankenphp" ]; then
    if [ -d "$dir/public" ] && [ -f "$dir/public/index.php" ]; then
      echo "public"
    elif [ -d "$dir/web" ] && [ -f "$dir/web/index.php" ]; then
      echo "web"
    elif [ -f "$dir/index.php" ]; then
      echo "."
    else
      echo "public"
    fi
  elif [ "$type" = "php-fpm" ] || [ "$type" = "php-legacy" ]; then
    if [ -d "$dir/public" ] && [ -f "$dir/public/index.php" ]; then
      echo "public"
    elif [ -d "$dir/web" ] && [ -f "$dir/web/index.php" ]; then
      echo "web"
    elif [ -f "$dir/index.php" ]; then
      echo "."
    else
      echo "public"
    fi
  elif [ "$type" = "php-ancient" ]; then
    if [ -f "$dir/index.php" ]; then
      echo "."
    else
      echo "."
    fi
  else
    echo "."
  fi
}

# ── Generate Dampfile ──────────────────────────────────────────
generate_dampfile() {
  local target="$1"
  local project="$2"
  local ptype="$3"
  local php_ver="${4:-}"
  local doc_root="${5:-}"
  local dbname="$6"
  local node_port="${7:-}"
  local domain="${project}.${DAMP_TLD}"

  cat > "$target/Dampfile" <<EOF
# Dampfile v1.0
version: "1.0"

project:
  name: ${project}
  domain: ${domain}
  type: ${ptype}
EOF

  if [ "$ptype" = "frankenphp" ] || [ "$ptype" = "php-fpm" ] || [ "$ptype" = "php-legacy" ] || [ "$ptype" = "php-ancient" ]; then
    cat >> "$target/Dampfile" <<EOF

runtime:
  php_version: "${php_ver}"
  document_root: ${doc_root}
EOF
  fi

  if [ "$ptype" = "node" ] && [ -n "$node_port" ]; then
    cat >> "$target/Dampfile" <<EOF

runtime:
  port: ${node_port}
EOF
  fi

  if [ -n "$dbname" ]; then
    cat >> "$target/Dampfile" <<EOF

database:
  name: ${dbname}
  create: true
EOF
  fi
}

# ── Generate docker-compose.yml from Dampfile config ───────────
generate_docker_compose() {
  local target="$1"
  local project="$2"
  local ptype="$3"
  local dbname="$4"
  local node_cmd="${5:-npm install && npm run dev -- --host}"

  case "$ptype" in
    frankenphp)
      cat > "$target/docker-compose.yml" <<EOF
services:
  app:
    build: .
    container_name: ${project}-app
    environment:
      - CI_ENVIRONMENT=development
      - database.default.hostname=damp-db
      - database.default.database=${dbname}
      - database.default.username=root
      - database.default.password=root
      - database.default.DBDriver=MySQLi
      - database.default.port=3306
    volumes:
      - ./:/app
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
    restart: unless-stopped
    networks:
      - damp

networks:
  damp:
    external: true
EOF
      ;;
    php-fpm)
      cat > "$target/docker-compose.yml" <<EOF
services:
  app:
    build: .
    container_name: ${project}-app
    volumes:
      - ./:/app
    environment:
      - CI_ENVIRONMENT=development
      - database.default.hostname=damp-db
      - database.default.database=${dbname}
      - database.default.username=root
      - database.default.password=root
      - database.default.DBDriver=MySQLi
      - database.default.port=3306
    restart: unless-stopped
    networks:
      - damp

  web:
    image: nginx:alpine
    container_name: ${project}-web
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - ./:/app:ro
    depends_on:
      - app
    restart: unless-stopped
    networks:
      - damp

networks:
  damp:
    external: true
EOF
      ;;
    php-legacy)
      cat > "$target/docker-compose.yml" <<EOF
services:
  app:
    build: .
    container_name: ${project}-app
    volumes:
      - ./:/app
    environment:
      - CI_ENVIRONMENT=development
    restart: unless-stopped
    networks:
      - damp

  web:
    image: nginx:alpine
    container_name: ${project}-web
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - ./:/app:ro
    depends_on:
      - app
    restart: unless-stopped
    networks:
      - damp

networks:
  damp:
    external: true
EOF
      ;;
    php-ancient)
      cat > "$target/docker-compose.yml" <<EOF
services:
  app:
    build: .
    container_name: ${project}-app
    volumes:
      - ./:/var/www/html
    environment:
      - MYSQL_HOST=damp-db
      - MYSQL_DATABASE=${dbname}
      - MYSQL_USER=root
      - MYSQL_PASSWORD=root
    restart: unless-stopped
    networks:
      - damp

networks:
  damp:
    external: true
EOF
      ;;
    node)
      cat > "$target/docker-compose.yml" <<EOF
services:
  app:
    image: node:22-alpine
    container_name: ${project}-app
    working_dir: /app
    volumes:
      - ./:/app
    command: sh -c "${node_cmd}"
    environment:
      - NODE_ENV=development
    restart: unless-stopped
    networks:
      - damp

networks:
  damp:
    external: true
EOF
      ;;
    wordpress)
      cat > "$target/docker-compose.yml" <<EOF
services:
  app:
    image: wordpress:latest
    container_name: ${project}-app
    restart: unless-stopped
    environment:
      WORDPRESS_DB_HOST: damp-db
      WORDPRESS_DB_USER: root
      WORDPRESS_DB_PASSWORD: root
      WORDPRESS_DB_NAME: ${dbname}
    volumes:
      - ./:/var/www/html
    networks:
      - damp

networks:
  damp:
    external: true
EOF
      ;;
  esac
}

# ── Generate Dockerfile based on type and PHP version ──────────
generate_dockerfile() {
  local target="$1"
  local ptype="$2"
  local php_ver="$3"

  case "$ptype" in
    frankenphp)
      cat > "$target/Dockerfile" <<EOF
FROM dunglas/frankenphp:1-php${php_ver}

WORKDIR /app

RUN apt-get update && apt-get install -y \\
    git unzip libzip-dev libicu-dev libpng-dev \\
    libjpeg-dev libfreetype6-dev libonig-dev \\
    && rm -rf /var/lib/apt/lists/*

RUN docker-php-ext-configure gd --with-freetype --with-jpeg \\
    && docker-php-ext-install -j\$(nproc) \\
    intl pdo_mysql mysqli zip gd exif opcache mbstring

COPY Caddyfile /etc/caddy/Caddyfile

EXPOSE 80
CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]
EOF
      ;;
    php-fpm)
      cat > "$target/Dockerfile" <<EOF
FROM php:${php_ver}-fpm-alpine

WORKDIR /app

RUN apk add --no-cache \\
    git unzip icu-dev libzip-dev libpng-dev \\
    libjpeg-turbo-dev freetype-dev oniguruma-dev

RUN docker-php-ext-configure gd --with-freetype --with-jpeg \\
    && docker-php-ext-install -j\$(nproc) \\
    intl pdo_mysql mysqli zip gd exif opcache mbstring

COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

EXPOSE 9000
CMD ["php-fpm"]
EOF
      ;;
    php-legacy)
      cat > "$target/Dockerfile" <<EOF
FROM php:${php_ver}-fpm-alpine

WORKDIR /app

RUN apk add --no-cache \\
    git unzip icu-dev libzip-dev libpng-dev \\
    libjpeg-turbo-dev freetype-dev oniguruma-dev

RUN docker-php-ext-configure gd --with-freetype --with-jpeg \\
    && docker-php-ext-install -j\$(nproc) \\
    intl pdo_mysql mysqli zip gd exif opcache mbstring

COPY --from=composer:2.7 /usr/bin/composer /usr/bin/composer

EXPOSE 9000
CMD ["php-fpm"]
EOF
      ;;
    php-ancient)
      cat > "$target/Dockerfile" <<EOF
FROM php:5.6-apache

WORKDIR /var/www/html

RUN apt-get update && apt-get install -y \\
    libpng-dev libjpeg-dev libfreetype6-dev \\
    && docker-php-ext-configure gd --with-freetype --with-jpeg \\
    && docker-php-ext-install -j\$(nproc) gd mysql mysqli pdo_mysql \\
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN a2enmod rewrite

EXPOSE 80
EOF
      ;;
  esac
}

# ── Generate nginx.conf for PHP-FPM/Legacy ─────────────────────
generate_nginx_conf() {
  local target="$1"
  local doc_root="$2"
  local root_path
  if [ "$doc_root" = "." ]; then
    root_path="/app"
  else
    root_path="/app/${doc_root}"
  fi

  cat > "$target/nginx.conf" <<EOF
server {
    listen 80;
    server_name _;
    root ${root_path};

    index index.php index.html;

    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-Content-Type-Options "nosniff";

    location / {
        try_files \$uri \$uri/ /index.php?\$query_string;
    }

    location ~ \.php$ {
        fastcgi_pass app:9000;
        fastcgi_param SCRIPT_FILENAME \$realpath_root\$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_hide_header X-Powered-By;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
EOF
}

# ── Generate Caddyfile for FrankenPHP ──────────────────────────
generate_caddyfile() {
  local target="$1"
  local doc_root="$2"
  local root_path
  if [ "$doc_root" = "." ]; then
    root_path="/app"
  else
    root_path="/app/${doc_root}"
  fi

  cat > "$target/Caddyfile" <<EOF
{
	auto_https disable_redirects
	http_port 80
}

http://:80 {
	root * ${root_path}
	php_server

	@notStatic {
		not file
		not path *.ico *.css *.js *.gif *.jpg *.jpeg *.png *.svg *.woff *.woff2 *.ttf *.eot
	}
	rewrite @notStatic /index.php?{query}

	log {
		output stdout
		format console
	}
}
EOF
}

# ── Patch vite.config.js for DAMP compatibility ────────────────
patch_vite_config() {
  local dir="$1"
  local config_file=""
  for f in "$dir/vite.config.js" "$dir/vite.config.ts" "$dir/vite.config.mjs"; do
    if [ -f "$f" ]; then
      config_file="$f"
      break
    fi
  done

  if [ -z "$config_file" ]; then
    return 0
  fi

  if grep -q "allowedHosts" "$config_file" 2>/dev/null; then
    return 0
  fi

  echo -e "${YELLOW}Vite config detected: $(basename "$config_file")${NC}"
  echo -e "${DIM}DAMP requires host: '0.0.0.0' and allowedHosts: true for reverse-proxy access.${NC}"
  local confirm_patch
  confirm_patch=$(read_input "Apply DAMP compatibility patch? [Y/n]: " "Y")
  if [ "$confirm_patch" != "y" ] && [ "$confirm_patch" != "Y" ]; then
    return 0
  fi

  # Backup original
  cp "$config_file" "${config_file}.orig"

  # Use Python for safe JS config patching
  python3 - "$config_file" <<'PYEOF'
import sys, re
path = sys.argv[1]
with open(path, 'r') as f:
    content = f.read()

# Check if server: { exists
if 'server:' not in content:
    # Insert server block before last closing brace or at end
    content = content.rstrip()
    if content.endswith('}'):
        content = content[:-1] + "  server: {\n    host: '0.0.0.0',\n    allowedHosts: true,\n  },\n}"
    else:
        content += "\nexport const server = {\n  host: '0.0.0.0',\n  allowedHosts: true,\n}\n"
else:
    # Patch existing server block
    # Add host if missing
    if "host:" not in content:
        content = re.sub(r'(server:\s*\{)', r"\1\n    host: '0.0.0.0',", content, count=1)
    # Add allowedHosts if missing
    if "allowedHosts" not in content:
        content = re.sub(r'(server:\s*\{)', r"\1\n    allowedHosts: true,", content, count=1)

with open(path, 'w') as f:
    f.write(content)
PYEOF

  echo -e "${GREEN}✔ Patched $(basename "$config_file") (backup: $(basename "$config_file").orig)${NC}"
}

# ── Patch Vite proxy target for Docker network ─────────────────
patch_vite_proxy() {
  local dir="$1"
  local config_file=""
  for f in "$dir/vite.config.js" "$dir/vite.config.ts" "$dir/vite.config.mjs"; do
    if [ -f "$f" ]; then
      config_file="$f"
      break
    fi
  done

  if [ -z "$config_file" ]; then
    return 0
  fi

  # Check if proxy block points to a .test/.local/.dev domain
  if ! grep -qE "target:\s*['\"]https?://[^'\"]+\.(test|local|dev|example)['\"]" "$config_file" 2>/dev/null; then
    return 0
  fi

  echo -e "${YELLOW}Vite proxy target uses local domain (e.g., .test).${NC}"
  echo -e "${DIM}Inside Docker, domains like 'project.test' won't resolve.${NC}"
  echo -e "${DIM}DAMP can switch proxy targets to container names (e.g., http://project-app:80).${NC}"
  local confirm_proxy
  confirm_proxy=$(read_input "Fix proxy targets for Docker network? [Y/n]: " "Y")
  if [ "$confirm_proxy" != "y" ] && [ "$confirm_proxy" != "Y" ]; then
    return 0
  fi

  # Backup if not already backed up
  if [ ! -f "${config_file}.orig" ]; then
    cp "$config_file" "${config_file}.orig"
  fi

  python3 - "$config_file" <<'PYEOF'
import sys, re
path = sys.argv[1]
with open(path, 'r') as f:
    content = f.read()

# Replace proxy targets pointing to .test/.local/.dev domains
# https://some-project.test  -> http://some-project-app:80
# http://api.local           -> http://api-app:80

def replace_target(match):
    full = match.group(0)
    quote = match.group(1)
    url = match.group(2)
    # Extract project name from domain
    m = re.match(r'https?://([^/]+)', url)
    if not m:
        return full
    domain = m.group(1)
    # Remove port if present
    domain_no_port = domain.split(':')[0]
    project_name = domain_no_port.split('.')[0]
    new_url = f'http://{project_name}-app:80'
    return full.replace(url, new_url)

# Match both single and double quotes
content = re.sub(
    r"(target:\s*['\"])(https?://[^'\"]+\.(?:test|local|dev|example)[^'\"]*)['\"]",
    replace_target,
    content
)

with open(path, 'w') as f:
    f.write(content)
PYEOF

  echo -e "${GREEN}✔ Fixed proxy targets in $(basename "$config_file")${NC}"
}

# ── Confirm overwrite (no .bak) ────────────────────────────────
confirm_overwrite() {
  local filepath="$1"
  if [ -f "$filepath" ]; then
    local fname
    fname=$(basename "$filepath")
    echo -e "${YELLOW}File '${fname}' already exists.${NC}" >&2
    local answer
    answer=$(read_input "Overwrite? [y/N]: " "")
    if [ "$answer" != "y" ] && [ "$answer" != "Y" ]; then
      return 1
    fi
  fi
  return 0
}

# ── Detect Node.js dev server port from package.json ───────────
detect_node_port() {
  local dir="$1"
  local pkg="$dir/package.json"
  if [ -f "$pkg" ]; then
    if grep -q '"vite"' "$pkg" 2>/dev/null; then
      echo "5173"
    elif grep -q '"astro"' "$pkg" 2>/dev/null; then
      echo "4321"
    elif grep -q '"next"' "$pkg" 2>/dev/null; then
      echo "3000"
    elif grep -q '"nuxt"' "$pkg" 2>/dev/null; then
      echo "3000"
    elif grep -q '"react-scripts"' "$pkg" 2>/dev/null; then
      echo "3000"
    elif grep -q '"@angular/cli"' "$pkg" 2>/dev/null; then
      echo "4200"
    elif grep -q '"@sveltejs/kit"' "$pkg" 2>/dev/null; then
      echo "5173"
    else
      echo "5173"
    fi
  else
    echo "5173"
  fi
}

# ── Detect Node.js dev command from package.json ───────────────
detect_node_command() {
  local dir="$1"
  local pkg="$dir/package.json"
  if [ -f "$pkg" ]; then
    if grep -q '"vite"' "$pkg" 2>/dev/null; then
      echo 'npm install && npm run dev -- --host'
    elif grep -q '"astro"' "$pkg" 2>/dev/null; then
      echo 'npm install && npm run dev -- --host'
    elif grep -q '"next"' "$pkg" 2>/dev/null; then
      echo 'npm install && npm run dev'
    elif grep -q '"nuxt"' "$pkg" 2>/dev/null; then
      echo 'npm install && npm run dev'
    elif grep -q '"react-scripts"' "$pkg" 2>/dev/null; then
      echo 'npm install && npm start'
    elif grep -q '"@angular/cli"' "$pkg" 2>/dev/null; then
      echo 'npm install && npm start -- --host 0.0.0.0'
    elif grep -q '"@sveltejs/kit"' "$pkg" 2>/dev/null; then
      echo 'npm install && npm run dev -- --host'
    else
      echo 'npm install && npm run dev -- --host'
    fi
  else
    echo 'npm install && npm run dev -- --host'
  fi
# ── Windows Interop Helpers ─────────────────────────────────────
is_wsl() {
  grep -qi microsoft /proc/version 2>/dev/null
}

# Run PowerShell command on Windows host
win_ps() {
  local cmd="$1"
  # Use powershell.exe from Windows path
  /mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe -NoProfile -NonInteractive -Command "$cmd"
}

# Run PowerShell as Admin
win_ps_admin() {
  local cmd="$1"
  # Replace " with \" to pass through to powershell
  local escaped_cmd="${cmd//\"/\\\"}"
  win_ps "Start-Process powershell -ArgumentList '-NoProfile', '-NonInteractive', '-Command', \"$escaped_cmd\" -Verb RunAs -Wait"
}

sync_windows_host() {
  local domain="$1"
  if is_wsl; then
    echo -e "${DIM}Syncing ${domain} to Windows hosts file...${NC}"
    local check_cmd="Get-Content C:\Windows\System32\drivers\etc\hosts | Select-String -Pattern '127.0.0.1\s+${domain}'"
    if ! win_ps "$check_cmd" >/dev/null 2>&1; then
      # Use `n for newline in PowerShell
      local add_cmd="Add-Content -Path C:\Windows\System32\drivers\etc\hosts -Value \"\`n127.0.0.1 ${domain}\" -ErrorAction SilentlyContinue"
      win_ps_admin "$add_cmd"
      echo -e "${GREEN}✓ ${domain} added to Windows hosts.${NC}"
    else
      echo -e "${DIM}✓ ${domain} already in Windows hosts.${NC}"
    fi
  fi
}

# ── Setup project (DB, Caddy, hosts, start) ────────────────────
setup_project() {
  local project="$1"
  local target="$2"
  local proxy_port="${3:-80}"
  local domain="${project}.${DAMP_TLD}"
  local dbname="${project//-/_}_db"

  # 1. Create database (skip for projects without DB)
  if [ -n "$dbname" ]; then
    echo -e "${DIM}Creating database '${dbname}'...${NC}"
    docker exec damp-db mysql -uroot -p"${DB_ROOT_PASSWORD:-root}" \
      -e "CREATE DATABASE IF NOT EXISTS \`$dbname\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;" 2>/dev/null
  fi

  # 2. Generate Caddy config in projects.d/
  mkdir -p "$PROJECTS_DIR"
  cat > "$PROJECTS_DIR/${project}.caddy" <<EOF
${domain} {
    reverse_proxy ${project}-app:${proxy_port}
}
EOF
  echo -e "${DIM}Caddy config created: projects.d/${project}.caddy${NC}"

  # 3. Add host entry (Linux/WSL)
  if ! grep -q "127.0.0.1.*$domain" /etc/hosts 2>/dev/null; then
    echo -e "${DIM}Adding ${domain} to /etc/hosts (requires sudo)...${NC}"
    if ! sudo sh -c "echo '127.0.0.1   $domain' >> /etc/hosts" 2>/dev/null; then
      echo -e "${YELLOW}Could not update /etc/hosts. Run manually:${NC}"
      echo -e "  sudo sh -c \"echo '127.0.0.1   ${domain}' >> /etc/hosts\""
    fi
  fi

  # 3b. Sync to Windows host
  sync_windows_host "$domain"

  # 4. Reload Caddy to pick up new config
  echo -e "${DIM}Reloading Caddy...${NC}"
  docker compose up -d caddy --force-recreate >/dev/null 2>&1

  # 5. Start project
  echo -e "${DIM}Starting project containers...${NC}"
  (cd "$target" && docker compose up -d)

  echo ""
  echo -e "${GREEN}${BOLD}✔ Project '${project}' is ready!${NC}"
  echo ""
  echo -e "  URL       → ${BOLD}https://${domain}${NC}"
  if [ -n "$dbname" ]; then
    echo -e "  Database  → ${BOLD}${dbname}${NC}"
  fi
  echo -e "  Directory → ${BOLD}${target}${NC}"
  echo ""
  echo -e "  ${DIM}Run ${BOLD}damp trust${NC}${DIM} if you haven't yet (HTTPS without warnings).${NC}"
}

CALLER_DIR="$(pwd)"

# Always run docker compose from the core directory where docker-compose.yml is
cd "$DAMP_CORE_DIR"

case "${1:-help}" in

  # ── Start ────────────────────────────────────────────────────
  up)
    echo -e "${GREEN}Starting DAMP Core Services...${NC}"
    docker compose up -d
    echo -e "${GREEN}DAMP is running.${NC}"
    echo ""
    
    # Sync core domains to Windows
    sync_windows_host "damp.${DAMP_TLD}"
    sync_windows_host "pma.${DAMP_TLD}"
    sync_windows_host "mail.${DAMP_TLD}"

    echo -e "  Dashboard   → ${BOLD}https://damp.${DAMP_TLD}${NC}  ${DIM}http://localhost:${DASHBOARD_PORT:-9200}${NC}"
    echo -e "  PHPMyAdmin  → ${BOLD}https://pma.${DAMP_TLD}${NC}   ${DIM}http://localhost:${PMA_PORT:-8080}${NC}"
    echo -e "  Mailpit     → ${BOLD}https://mail.${DAMP_TLD}${NC}  ${DIM}http://localhost:${MAIL_HTTP_PORT:-8025}${NC}"
    echo -e "  MySQL       → ${BOLD}localhost:${DB_PORT:-3306}${NC}"
    ;;

  # ── Stop ─────────────────────────────────────────────────────
  down)
    echo -e "${YELLOW}Stopping DAMP Core Services...${NC}"
    docker compose down
    echo -e "${YELLOW}DAMP stopped.${NC}"
    ;;

  # ── Restart ──────────────────────────────────────────────────
  restart)
    docker compose restart
    echo -e "${GREEN}DAMP restarted.${NC}"
    ;;

  # ── Status ───────────────────────────────────────────────────
  status)
    echo -e "${BOLD}DAMP Services:${NC}"
    docker compose ps --format "table {{.Name}}\t{{.Status}}\t{{.Ports}}" 2>/dev/null
    echo ""
    echo -e "${BOLD}Projects on damp network:${NC}"
    docker network inspect damp --format '{{range .Containers}}  {{.Name}}{{"\n"}}{{end}}' 2>/dev/null | sort
    ;;

  # ── Logs ─────────────────────────────────────────────────────
  logs)
    service="${2:-}"
    if [ -z "$service" ]; then
      docker compose logs -f --tail 50
    else
      docker compose logs -f --tail 50 "$service"
    fi
    ;;

  # ── Add domain to /etc/hosts ─────────────────────────────────
  add-host)
    domain="${2:-}"
    if [ -z "$domain" ]; then
      echo "Usage: damp add-host my-project.${DAMP_TLD}"
      exit 1
    fi
    if grep -q "127.0.0.1.*$domain" /etc/hosts 2>/dev/null; then
      echo -e "${YELLOW}$domain already exists in /etc/hosts${NC}"
    else
      sudo sh -c "echo '127.0.0.1   $domain' >> /etc/hosts"
      echo -e "${GREEN}$domain added to /etc/hosts${NC}"
    fi
    sync_windows_host "$domain"
    ;;

  # ── Create database ──────────────────────────────────────────
  create-db)
    dbname="${2:-}"
    if [ -z "$dbname" ]; then
      echo "Usage: damp create-db my_project_db"
      exit 1
    fi
    docker exec damp-db mysql -uroot -p"${DB_ROOT_PASSWORD:-root}" \
      -e "CREATE DATABASE IF NOT EXISTS \`$dbname\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;" 2>/dev/null
    echo -e "${GREEN}Database '$dbname' created.${NC}"
    ;;

  # ── List databases ───────────────────────────────────────────
  databases)
    docker exec damp-db mysql -uroot -p"${DB_ROOT_PASSWORD:-root}" \
      -e "SHOW DATABASES;" 2>/dev/null | grep -v "information_schema\|performance_schema\|mysql\|sys\|Database"
    ;;

  # ── Import SQL dump ──────────────────────────────────────────
  import)
    dbname="${2:-}"
    sqlfile="${3:-}"
    if [ -z "$dbname" ] || [ -z "$sqlfile" ]; then
      echo "Usage: damp import my_db dump.sql"
      exit 1
    fi
    if [ ! -f "$sqlfile" ]; then
      echo -e "${RED}File not found: $sqlfile${NC}"
      exit 1
    fi
    docker exec -i damp-db mysql -uroot -p"${DB_ROOT_PASSWORD:-root}" "$dbname" < "$sqlfile" 2>/dev/null
    echo -e "${GREEN}Imported '$sqlfile' → '$dbname'${NC}"
    ;;

  # ── Export SQL dump ──────────────────────────────────────────
  export)
    dbname="${2:-}"
    outfile="${3:-$dbname-$(date +%Y%m%d).sql}"
    if [ -z "$dbname" ]; then
      echo "Usage: damp export my_db [file.sql]"
      exit 1
    fi
    docker exec damp-db mysqldump -uroot -p"${DB_ROOT_PASSWORD:-root}" --single-transaction "$dbname" > "$outfile" 2>/dev/null
    echo -e "${GREEN}Exported '$dbname' → '$outfile'${NC}"
    ;;

  # ── Drop database ────────────────────────────────────────────
  drop-db)
    dbname="${2:-}"
    if [ -z "$dbname" ]; then
      echo "Usage: damp drop-db my_db"
      exit 1
    fi
    echo -e "${RED}This will permanently delete '$dbname'. Are you sure? [y/N]${NC}"
    read -r confirm
    if [ "$confirm" = "y" ] || [ "$confirm" = "Y" ]; then
      docker exec damp-db mysql -uroot -p"${DB_ROOT_PASSWORD:-root}" \
        -e "DROP DATABASE IF EXISTS \`$dbname\`;" 2>/dev/null
      echo -e "${GREEN}Database '$dbname' dropped.${NC}"
    else
      echo "Cancelled."
    fi
    ;;

  # ── Setup DNS ────────────────────────────────────────────────
  setup-dns)
    bash "$BIN_DIR/setup-dns.sh"
    ;;

  # ── Update ───────────────────────────────────────────────────
  update)
    echo -e "${GREEN}Updating DAMP...${NC}"
    cd "$DAMP_ROOT_DIR"
    git pull origin main
    echo -e "${DIM}Rebuilding dashboard...${NC}"
    cd "$DAMP_CORE_DIR"
    docker compose build dashboard
    docker compose up -d --force-recreate
    echo -e "${GREEN}DAMP updated to $(cat "$DAMP_ROOT_DIR/VERSION" 2>/dev/null || echo "latest").${NC}"
    ;;

  # ── Version ──────────────────────────────────────────────────
  version|--version|-v)
    echo "damp $DAMP_VERSION"
    ;;

  # ── Install CA ───────────────────────────────────────────────
  trust)
    bash "$BIN_DIR/trust-cert.sh"
    ;;


  # ── Reload Caddy ─────────────────────────────────────────────
  reload)
    docker compose up -d caddy --force-recreate
    echo -e "${GREEN}Caddy reloaded.${NC}"
    ;;

  # ── Start a project ──────────────────────────────────────────
  start)
    project="${2:-}"
    if [ -z "$project" ]; then
      echo "Usage: damp start <project-name>"
      exit 1
    fi
    # Search for the project's docker-compose.yml in common locations
    project_dir=""
    search_paths=(
      "$CALLER_DIR/$project"
      "$CALLER_DIR"
      "$DAMP_ROOT_DIR/$project"
      "$(dirname "$DAMP_ROOT_DIR")/$project"
    )
    for sp in "${search_paths[@]}"; do
      if [ -f "$sp/docker-compose.yml" ]; then
        # Verify it's actually this project (container name matches)
        if grep -q "${project}" "$sp/docker-compose.yml" 2>/dev/null; then
          project_dir="$sp"
          break
        fi
      fi
    done

    if [ -z "$project_dir" ]; then
      echo -e "${RED}Cannot find docker-compose.yml for '$project'.${NC}"
      echo -e "  ${DIM}Try: cd <project-folder> && docker compose up -d${NC}"
      exit 1
    fi

    echo -e "${GREEN}Starting $project...${NC}"
    (cd "$project_dir" && docker compose up -d)
    echo -e "${GREEN}$project is running.${NC}"
    ;;

  # ── Stop a project ──────────────────────────────────────────
  stop)
    project="${2:-}"
    if [ -z "$project" ]; then
      echo "Usage: damp stop <project-name>"
      exit 1
    fi
    # Stop all containers with this project prefix
    containers=$(docker ps -q --filter "name=^${project}-" 2>/dev/null)
    if [ -z "$containers" ]; then
      echo -e "${YELLOW}No running containers found for '$project'.${NC}"
      exit 0
    fi
    echo -e "${YELLOW}Stopping $project...${NC}"
    docker stop $containers
    echo -e "${YELLOW}$project stopped.${NC}"
    ;;

  # ── Exec into project container ──────────────────────────────
  exec)
    project="${2:-}"
    if [ -z "$project" ]; then
      echo "Usage: damp exec <project-name>"
      exit 1
    fi
    # Find container: matches project name, preferring those on damp network
    container=$(docker ps --filter "name=$project" --format "{{.Names}}" | head -n 1)
    if [ -z "$container" ]; then
      echo -e "${RED}Container for '$project' not found.${NC}"
      exit 1
    fi
    echo -e "${GREEN}Entering $container...${NC}"
    docker exec -it "$container" bash || docker exec -it "$container" sh
    ;;

  # ── Init existing project (Dampfile workflow) ────────────────
  init)
    target="$CALLER_DIR"

    # Must be inside an existing project
    if [ ! "$(ls -A "$target" 2>/dev/null)" ]; then
      echo -e "${RED}Current directory is empty. Use 'damp new' to create a project.${NC}"
      exit 1
    fi

    echo ""
    echo -e "${BOLD}DAMP Init — Interactive Project Setup${NC}"
    echo -e "${DIM}Press Enter to accept defaults.${NC}"
    echo ""

    # 1. Project name
    default_name=$(basename "$CALLER_DIR" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9-]/-/g' | sed 's/-\+/-/g' | sed 's/^-//;s/-$//')
    project=$(read_input "Project name [${default_name}]: " "$default_name")
    project=$(echo "$project" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9-]/-/g' | sed 's/-\+/-/g' | sed 's/^-//;s/-$//')

    # 2. Detect project type
    template=$(detect_template "$target")
    if [ -n "$template" ]; then
      echo -e "${DIM}Detected project type: ${BOLD}${template}${NC}"
      confirm_template=$(read_input "Use this type? [Y/n]: " "Y")
      if [ "$confirm_template" = "n" ] || [ "$confirm_template" = "N" ]; then
        template=""
      fi
    fi
    if [ -z "$template" ]; then
      template=$(select_template)
      if [ -z "$template" ]; then
        echo -e "${RED}Invalid selection.${NC}"
        exit 1
      fi
    fi

    # 3. PHP-specific questions
    php_version=""
    document_root=""
    node_port=""
    node_cmd=""
    if [ "$template" = "frankenphp" ] || [ "$template" = "php-fpm" ] || [ "$template" = "php-legacy" ] || [ "$template" = "php-ancient" ]; then
      detected_php=$(detect_php_version "$target")
      php_version=$(read_input "PHP version [${detected_php}]: " "$detected_php")

      detected_root=$(detect_document_root "$target" "$template")
      document_root=$(read_input "Document root [${detected_root}]: " "$detected_root")
    elif [ "$template" = "node" ]; then
      detected_port=$(detect_node_port "$target")
      node_port=$(read_input "Dev server port [${detected_port}]: " "$detected_port")
      node_cmd=$(detect_node_command "$target")
      patch_vite_config "$target"
      patch_vite_proxy "$target"
    fi

    # 4. Database
    default_db="${project//-/_}_db"
    if [ "$template" = "node" ]; then
      confirm_db=$(read_input "Create database? [y/N]: " "N")
    else
      confirm_db=$(read_input "Create database? [Y/n]: " "Y")
    fi
    if [ "$confirm_db" = "y" ] || [ "$confirm_db" = "Y" ]; then
      dbname=$(read_input "Database name [${default_db}]: " "$default_db")
    else
      dbname=""
    fi

    # 5. Check for existing Dampfile
    if [ -f "$target/Dampfile" ]; then
      echo -e "${YELLOW}A Dampfile already exists in this directory.${NC}"
      overwrite_all=$(read_input "Overwrite all generated files? [y/N]: " "")
      if [ "$overwrite_all" != "y" ] && [ "$overwrite_all" != "Y" ]; then
        echo "Cancelled."
        exit 0
      fi
    fi

    # 6. Generate Dampfile
    generate_dampfile "$target" "$project" "$template" "$php_version" "$document_root" "$dbname" "$node_port"
    echo -e "${GREEN}✔ Generated Dampfile${NC}"

    # 7. Generate docker-compose.yml
    generate_docker_compose "$target" "$project" "$template" "$dbname" "$node_cmd"
    echo -e "${GREEN}✔ Generated docker-compose.yml${NC}"

    # 8. Generate type-specific files
    case "$template" in
      frankenphp)
        if confirm_overwrite "$target/Dockerfile"; then
          generate_dockerfile "$target" "$template" "$php_version"
          echo -e "${GREEN}✔ Generated Dockerfile${NC}"
        fi
        if confirm_overwrite "$target/Caddyfile"; then
          generate_caddyfile "$target" "$document_root"
          echo -e "${GREEN}✔ Generated Caddyfile${NC}"
        fi
        ;;
      php-fpm|php-legacy)
        if confirm_overwrite "$target/Dockerfile"; then
          generate_dockerfile "$target" "$template" "$php_version"
          echo -e "${GREEN}✔ Generated Dockerfile${NC}"
        fi
        if confirm_overwrite "$target/nginx.conf"; then
          generate_nginx_conf "$target" "$document_root"
          echo -e "${GREEN}✔ Generated nginx.conf${NC}"
        fi
        ;;
      php-ancient)
        if confirm_overwrite "$target/Dockerfile"; then
          generate_dockerfile "$target" "$template" "$php_version"
          echo -e "${GREEN}✔ Generated Dockerfile${NC}"
        fi
        ;;
    esac

    echo ""
    echo -e "${GREEN}${BOLD}✔ Project '${project}' configured with Dampfile.${NC}"

    # 9. Auto-setup: DB, Caddy, hosts, start
    if [ "$template" = "node" ]; then
      setup_project "$project" "$target" "$node_port"
    else
      setup_project "$project" "$target"
    fi
    ;;

  # ── New project from template ────────────────────────────────
  new)
    arg1="${2:-}"
    arg2="${3:-}"

    # Parse arguments: `damp new <name>` or `damp new <template> <name>`
    if [ -z "$arg1" ]; then
      echo "Usage: damp new <project-name>"
      echo "       damp new <template> <project-name>"
      exit 1
    fi

    if [ -n "$arg2" ]; then
      # Two args: damp new <template> <name>
      template="$arg1"
      project="$arg2"
    else
      # One arg: damp new <name> — detect or ask
      project="$arg1"
    fi

    # Normalize project name: lowercase, only a-z 0-9 hyphens
    project=$(echo "$project" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9-]/-/g' | sed 's/-\+/-/g' | sed 's/^-//;s/-$//')

    if [ -z "$arg2" ]; then
      template=""

      target="$CALLER_DIR/$project"
      # Try to detect from existing files
      if [ -d "$target" ] && [ "$(ls -A "$target" 2>/dev/null)" ]; then
        detected=$(detect_template "$target")
        if [ -n "$detected" ]; then
          echo -e "Detected existing project: ${BOLD}${detected}${NC}"
          echo -n "Use this template? [Y/n]: "
          if (echo >/dev/tty) 2>/dev/null; then
            read -r confirm </dev/tty
          else
            read -r confirm
          fi
          if [ "$confirm" != "n" ] && [ "$confirm" != "N" ]; then
            template="$detected"
          fi
        fi
      fi

      # If not detected, show selector
      if [ -z "$template" ]; then
        template=$(select_template)
        if [ -z "$template" ]; then
          echo -e "${RED}Invalid selection.${NC}"
          exit 1
        fi
      fi
    fi

    # Validate template
    if [ ! -d "$TEMPLATES_DIR/$template" ]; then
      echo -e "${RED}Template '$template' not found.${NC}"
      echo "Available: $(ls -1 "$TEMPLATES_DIR" | tr '\n' ' ')"
      exit 1
    fi

    target="$CALLER_DIR/$project"
    mkdir -p "$target"
    cp -r "$TEMPLATES_DIR/$template/"* "$target/"

    # Replace PROJECT_NAME
    if [[ "$OSTYPE" == "darwin"* ]]; then
      find "$target" -type f -exec sed -i '' "s/PROJECT_NAME/$project/g" {} +
    else
      find "$target" -type f -exec sed -i "s/PROJECT_NAME/$project/g" {} +
    fi

    echo -e "${GREEN}Project '$project' created from template '${template}'.${NC}"

    # Auto-setup: DB, Caddy, hosts, start
    setup_project "$project" "$target"
    ;;

  # ── List projects ─────────────────────────────────────────────
  list)
    echo -e "${BOLD}DAMP Projects:${NC}"
    echo ""
    if [ ! -d "$PROJECTS_DIR" ] || [ -z "$(ls -A "$PROJECTS_DIR"/*.caddy 2>/dev/null)" ]; then
      echo -e "  ${DIM}No projects registered. Create one with: damp new <name>${NC}"
      exit 0
    fi
    printf "  ${BOLD}%-20s %-25s %-10s${NC}\n" "PROJECT" "DOMAIN" "STATUS"
    printf "  %-20s %-25s %-10s\n" "───────────────────" "────────────────────────" "─────────"
    for caddy_file in "$PROJECTS_DIR"/*.caddy; do
      name="$(basename "$caddy_file" .caddy)"
      domain="${name}.${DAMP_TLD}"
      status=$(docker ps --filter "name=^${name}-" --format "{{.Status}}" 2>/dev/null | head -1)
      if [ -n "$status" ]; then
        printf "  %-20s %-25s ${GREEN}%-10s${NC}\n" "$name" "$domain" "running"
      else
        printf "  %-20s %-25s ${DIM}%-10s${NC}\n" "$name" "$domain" "stopped"
      fi
    done
    echo ""
    ;;

  # ── Help ─────────────────────────────────────────────────────
  help|*)
    echo -e "${BOLD}DAMP${NC} ${DIM}v$DAMP_VERSION${NC} — Dockerized Auto-SSL Modern Platform"
    echo -e "${DIM}A modern replacement for MAMP, XAMPP, WAMP, and LAMP.${NC}"
    echo ""
    echo -e "${BOLD}Usage:${NC} damp <command> [args]"
    echo ""
    echo -e "${BOLD}Services:${NC}"
    echo "  up              Start DAMP"
    echo "  down            Stop DAMP"
    echo "  restart         Restart DAMP"
    echo "  status          Show service status"
    echo "  logs [svc]      View logs (optional: specific service)"
    echo "  exec <project>  Execute bash inside project container"
    echo "  reload          Reload Caddy (after changing Caddyfile)"
    echo ""
    echo -e "${BOLD}Database:${NC}"
    echo "  databases       List databases"
    echo "  create-db <db>  Create a database"
    echo "  drop-db <db>    Drop a database (with confirmation)"
    echo "  import <db> <f> Import SQL dump"
    echo "  export <db> [f] Export SQL dump"
    echo ""
    echo -e "${BOLD}Projects:${NC}"
    echo "  new <name>        Create project (interactive template selector)"
    echo "  new <tpl> <name>  Create project from specific template"
    echo "  init [name]       Init existing project (run from project dir)"
    echo "  start <project>   Start a project's containers"
    echo "  stop <project>    Stop a project's containers"
    echo "  list              List registered projects"
    echo "  add-host <domain> Add domain to /etc/hosts"
    echo ""
    echo -e "${BOLD}SSL & DNS:${NC}"
    echo "  trust           Install CA in system keychain (HTTPS without warnings)"
    echo "  setup-dns       Configure host to resolve *.${DAMP_TLD} without /etc/hosts"
    echo ""
    echo -e "${BOLD}Meta:${NC}"
    echo "  update          Pull latest version and rebuild"
    echo "  version         Show DAMP version"
    echo "  help            Show this help"
    ;;
esac
