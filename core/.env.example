# =============================================================
# DAMP — Configuration
# =============================================================
# Copy this file to .env and adjust as needed:
#   cp .env.example .env
# =============================================================

# ── General ─────────────────────────────────────────────────
TZ=UTC

# ── Domain TLD ─────────────────────────────────────────────
# All project domains use this suffix: my-project.{TLD}
# Options: local (default), test, dev
DAMP_TLD=local

# ── Caddy (Reverse Proxy) ──────────────────────────────────
CADDY_EMAIL=admin@localhost

# ── Domains — used by Caddyfile ─────────────────────────────
DAMP_DOMAIN=damp.${DAMP_TLD}
PMA_DOMAIN=pma.${DAMP_TLD}
MAIL_DOMAIN=mail.${DAMP_TLD}

# ── MySQL ───────────────────────────────────────────────────
DB_ROOT_PASSWORD=root
DB_PORT=3306

# ── Runtime budgets (DAMP 0.8) ─────────────────────────────
# Hard limits protect the host from memory/swap thrashing. Increase a project
# budget in its Dampfile/compose file rather than removing limits globally.
MYSQL_MEMORY_LIMIT=384m
MYSQL_CPU_LIMIT=1.50
CADDY_MEMORY_LIMIT=96m
CADDY_CPU_LIMIT=0.50
DASHBOARD_MEMORY_LIMIT=128m
DASHBOARD_CPU_LIMIT=1.00
POSTGRES_MEMORY_LIMIT=256m
REDIS_MEMORY_LIMIT=96m
REDIS_MAXMEMORY=64mb
PMA_MEMORY_LIMIT=192m
MAILPIT_MEMORY_LIMIT=96m

# ── PHPMyAdmin ──────────────────────────────────────────────
PMA_PORT=8080

# ── Dashboard ──────────────────────────────────────────────
DASHBOARD_PORT=9200

# ── Mailpit ─────────────────────────────────────────────────
MAIL_HTTP_PORT=8025
MAIL_SMTP_PORT=1025

# ── Projects ────────────────────────────────────────────────
# Base path for the folder browser in the dashboard.
# macOS/Linux: leave empty (uses $HOME automatically)
# WSL2: set to /mnt/c/Users to browse Windows drives
# DAMP_PROJECTS_ROOT=/mnt/c/Users
#
# Add your project domains here. Each needs a block in Caddyfile.
# MY_PROJECT_DOMAIN=myproject.local
