# =============================================================
# DAMP — Configuration
# =============================================================
# Copy this file to .env and adjust as needed:
#   cp .env.example .env
# =============================================================

# ── General ─────────────────────────────────────────────────
TZ=UTC

# ── Domain TLD ─────────────────────────────────────────────
# All project domains use this suffix: my-project.{TLD}
# Options: local (default), test, dev
DAMP_TLD=local

# ── Caddy (Reverse Proxy) ──────────────────────────────────
CADDY_EMAIL=admin@localhost

# ── Domains — used by Caddyfile ─────────────────────────────
DAMP_DOMAIN=damp.${DAMP_TLD}
PMA_DOMAIN=pma.${DAMP_TLD}
MAIL_DOMAIN=mail.${DAMP_TLD}

# ── MySQL ───────────────────────────────────────────────────
DB_ROOT_PASSWORD=root
DB_PORT=3306

# ── PHPMyAdmin ──────────────────────────────────────────────
PMA_PORT=8080

# ── Dashboard ──────────────────────────────────────────────
DASHBOARD_PORT=9200

# ── Mailpit ─────────────────────────────────────────────────
MAIL_HTTP_PORT=8025
MAIL_SMTP_PORT=1025

# ── Projects ────────────────────────────────────────────────
# Base path for the folder browser in the dashboard.
# macOS/Linux: leave empty (uses $HOME automatically)
# WSL2: set to /mnt/c/Users to browse Windows drives
# DAMP_PROJECTS_ROOT=/mnt/c/Users
#
# Add your project domains here. Each needs a block in Caddyfile.
# MY_PROJECT_DOMAIN=myproject.local
